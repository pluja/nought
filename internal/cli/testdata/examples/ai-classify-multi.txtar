[windows] skip 'needs a POSIX sh'
[!exec:jq] skip 'needs jq'

# Up to NOU_AI_MAX_TAGS tags each (3 by default). Each is checked on its own:
# repeats, tags not on the list, nou's own and ones with spaces are dropped.
exec nou import export --account personal --inbox
exec nou msg tag --add classify -- '*'
chmod 755 bin/curl
env PATH=$WORK/bin${:}$PATH
env NOU_AI_TAGS='receipts travel work'
exec sh $EXAMPLES/ai-classify.sh
stdout ' receipts, travel$'
exec nou search tag:receipts tag:travel
stdout 'Your hotel'
exec nou search tag:deleted OR tag:bogus
! stdout .
grep '"tags":\{"type":"array","items":\{"type":"string","enum":\["receipts","travel","work"\]\}\}' last.body
grep 'as few tags as fit \(at most 3\)' last.body

# With new tags allowed, a made-up one joins them; "two words" does not.
exec nou msg tag subject:hotel --add classify
env NOU_AI_NEW_TAGS=1
exec sh $EXAMPLES/ai-classify.sh
stdout ' receipts, travel, lisbon-trip \(new\)$'
env NOU_AI_NEW_TAGS=

# NOU_AI_MAX_TAGS=1: the best one only.
exec nou msg tag subject:hotel --add classify
env NOU_AI_MAX_TAGS=1
exec sh $EXAMPLES/ai-classify.sh
stdout ' receipts$'
env NOU_AI_MAX_TAGS=x
exec nou msg tag subject:hotel --add classify
! exec sh $EXAMPLES/ai-classify.sh
stderr 'NOU_AI_MAX_TAGS must be a number from 1'

-- bin/curl --
#!/bin/sh
body=$(cat)
printf '%s\n' "$body" >"$WORK/last.body"
answer='{"tags": ["Receipts", "travel", "receipts", "deleted", "two words", "lisbon-trip", "bogus"]}'
jq -n --arg c "$answer" '{choices: [{message: {role: "assistant", content: $c}}]}'
-- export/Inbox/a.eml --
From: Hotel <stay@hotel.example>
Message-ID: <a@example.org>
Subject: Your hotel booking in Lisbon

Receipt for two nights.
